# 사백나나 입지랩 AI — 환경변수 예시
# 실제 값은 .env.local 에 넣고 절대 커밋하지 마세요.

# 앱 이름 (화면 타이틀 등에 사용, 나중에 쉽게 변경 가능)
NEXT_PUBLIC_APP_NAME="사백나나 입지랩 AI"

# 데이터베이스 (Prisma). 개발: SQLite, 운영: PostgreSQL 등으로 교체
DATABASE_URL="file:./dev.db"

# Provider 모드: mock(기본, 공공 API 키 없이 전체 흐름 데모) | live(실제 API 연동)
# live로 바꿔도 아파트 실거래(국토교통부)만 실제 연동되며, 나머지 Provider는
# 아직 전부 Mock을 사용한다 (README "지금 무엇이 실제로 동작하는가" 참고).
PROVIDER_MODE="mock"

# 공공데이터포털 (data.go.kr) 마이페이지에서 "국토교통부_아파트 매매 실거래가 상세 자료"
# 활용신청 후 발급되는 서비스키. "Decoding(디코딩)" 키를 넣을 것 — "Encoding" 키를
# 넣으면 이중 인코딩되어 인증에 실패할 수 있다.
# PROVIDER_MODE=live일 때만 사용됨. 커버 지역은 src/lib/reference/lawdCode.ts
# 표에 있는 곳(서울 25개구, 수원/성남)으로 제한되어 있으니 필요시 표를 확장할 것.
DATA_GO_KR_API_KEY=

# 통계청 SGIS — 미구현, 연동 시 필요
SGIS_API_KEY=
SGIS_SECRET_KEY=

# VWorld (국가공간정보) — 미구현, 연동 시 필요
VWORLD_API_KEY=

# 지도/지오코딩 — 미구현, 연동 시 필요 (현재는 Mock 지오코더만 동작)
KAKAO_MAP_KEY=
NAVER_MAP_KEY=

# AI 리포트 — 미구현 (현재는 Mock AI Provider가 Evidence만 인용해 문장을 조립)
AI_PROVIDER="mock"
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
