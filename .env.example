# 사백나나 입지랩 AI — 환경변수 예시
# 실제 값은 .env.local 에 넣고 절대 커밋하지 마세요.

# 앱 이름 (화면 타이틀 등에 사용, 나중에 쉽게 변경 가능)
NEXT_PUBLIC_APP_NAME="사백나나 입지랩 AI"

# 데이터베이스 (Prisma). 개발: SQLite, 운영: PostgreSQL 등으로 교체
DATABASE_URL="file:./dev.db"

# Provider 모드: mock(기본, 공공 API 키 없이 전체 흐름 데모) | live(실제 API 연동, 미구현)
PROVIDER_MODE="mock"

# 공공데이터포털 (국토교통부 실거래가 등) — 미구현, 연동 시 필요
DATA_GO_KR_API_KEY=

# 통계청 SGIS — 미구현, 연동 시 필요
SGIS_API_KEY=
SGIS_SECRET_KEY=

# VWorld (국가공간정보) — 미구현, 연동 시 필요
VWORLD_API_KEY=

# 지도/지오코딩 — 미구현, 연동 시 필요 (현재는 Mock 지오코더만 동작)
KAKAO_MAP_KEY=
NAVER_MAP_KEY=

# AI 리포트 — 미구현 (현재는 Mock AI Provider가 Evidence만 인용해 문장을 조립)
AI_PROVIDER="mock"
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
